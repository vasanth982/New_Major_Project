# -------------------------------------------------------------
# Checkup Buddy - Streamlit Secrets Template (.streamlit/secrets.toml.example)
# Safe to commit to version control (contains NO real credentials).
# For Streamlit Community Cloud: paste into App Settings -> Secrets.
# For local development: copy to .streamlit/secrets.toml
# -------------------------------------------------------------

# Gmail SMTP Configuration for Email OTP verification
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = 587
SMTP_USER = "your_email@gmail.com"
SMTP_APP_PASSWORD = "xxxx xxxx xxxx xxxx"

# Initial Owner / Administrator credentials
OWNER_EMAIL = "owner@example.com"
OWNER_PASSWORD = "change_this_password"

# Optional: Twilio SMS Configuration (if SMS OTP is enabled)
# TWILIO_ACCOUNT_SID = "AC00000000000000000000000000000000"
# TWILIO_AUTH_TOKEN = "your_twilio_auth_token_here"
# TWILIO_PHONE_NUMBER = "+10000000000"
