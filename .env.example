# -------------------------------------------------------------
# Checkup Buddy Environment Configuration Template (.env.example)
# Copy this file to .env and configure your production credentials.
# In local development, missing keys will fall back to secure console logging.
# -------------------------------------------------------------

# --- Owner Account Auto-Seeding (Optional) ---
OWNER_EMAIL=owner@hospital.example.com
OWNER_PASSWORD=change_this_to_a_secure_owner_password
OWNER_MOBILE=+10000000000

# --- SMTP Email Configuration for OTP Delivery ---
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@sandbox.example.com
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM=noreply@checkupbuddy.example.com

# --- Twilio SMS Configuration for OTP Delivery ---
TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+10000000000
